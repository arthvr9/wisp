{
  "name": "wisp",
  "version": "0.0.0",
  "private": true,
  "description": "A desktop mascot for GNOME. Phase 0: window mechanics spike.",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev -- --ozone-platform=x11 --no-sandbox",
    "build": "electron-vite build",
    "start": "electron-vite preview -- --ozone-platform=x11 --no-sandbox",
    "harness": "electron-vite build && WISP_HARNESS_MINUTES=10 electron . --ozone-platform=x11 --no-sandbox",
    "harness:short": "electron-vite build && WISP_HARNESS_MINUTES=1 WISP_SELFTEST=1 electron . --ozone-platform=x11 --no-sandbox",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sprites": "node scripts/make-placeholder-sprites.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.1.1",
    "electron-vite": "^5.0.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
